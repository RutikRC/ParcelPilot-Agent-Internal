APP_NAME="AI Document Service"
APP_ENV=development
APP_PORT=8000

OLLAMA_BASE_URL=http://localhost:11434

# LLM / RAG Generation
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# PostgreSQL Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
